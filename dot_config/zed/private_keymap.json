// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      // pane nagvigation
      "ctrl-cmd-j": "workspace::ActivatePaneDown",
      "ctrl-cmd-k": "workspace::ActivatePaneUp",

      // pane splitting
      "cmd-d": "pane::SplitRight",
      "ctrl-cmd-d": "pane::SplitDown",
      "cmd--": "zed::DecreaseBufferFontSize",
      "cmd-=": "zed::IncreaseBufferFontSize"
    }
  },
  {
    "bindings": {
      "ctrl-g": ["task::Spawn", { "task_name": "start lazygit" }],
      // Here we also allow `alt-enter` to accept the prediction
      "alt-enter": "editor::AcceptEditPrediction",
      "shift-enter": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "f d": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "shift-k": "editor::Hover"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-r": "projects::OpenRecent",
      "f4": "zed::OpenLog",
      "f5": "dev::OpenLanguageServerLogs",
      "f10": "workspace::ToggleCenteredLayout"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-cmd-d": [
        "editor::SelectPrevious",
        {
          "replace_newest": false
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "unbind": {
      "ctrl-cmd-l": "lsp_tool::ToggleMenu"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-cmd-p": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-p": "editor::ShowSignatureHelp"
    }
  }
]
